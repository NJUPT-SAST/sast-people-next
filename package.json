{
  "name": "sast-people",
  "version": "0.1.0",
  "description": "Recruitment workflows, grading, interview review, and result notifications for NJUPT SAST.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "dev:db": "next dev",
    "dev:local": "sh scripts/dev-local.sh",
    "dev:full": "concurrently \"cross-env INNGEST_DEV=1 next dev -p 3001\" \"inngest-cli dev --no-discovery -u http://localhost:3001/api/inngest\" \"email dev --dir=emails --port=3002\"",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:dev:logs": "docker compose -f docker-compose.dev.yml logs -f postgres-dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "node scripts/run-sql-file.mjs scripts/seed-demo-dev.sql \"Seeded demo development data.\" && node scripts/seed-demo-email-snapshots.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "^5.2.9",
    "@hookform/resolvers": "^5.9.0",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/render": "^2.0.8",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.22",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "framer-motion": "^12.40.0",
    "inngest": "^4.18.0",
    "jose": "^6.2.9",
    "lucide-react": "^0.577.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.21.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-media-devices": "^1.2.1",
    "react-qr-code": "^2.0.21",
    "react-zxing": "^2.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.1",
    "inngest-cli": "^1.41.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "react-email": "^6.9.2",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
