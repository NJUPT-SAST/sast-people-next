{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui:dev",
      "type": "shell",
      "isBackground": true,
      "command": "pnpm",
      "args": ["dev"],
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|ready started server on)"
        }
      }
    },
    {
      "label": "ui:dev-if-needed",
      "type": "shell",
      "isBackground": true,
      // Default command won't be used due to per-OS overrides below
      "command": "pnpm",
      "args": ["dev"],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "if (Get-NetTCPConnection -LocalPort 3000 -State Listen -ErrorAction SilentlyContinue) { exit 0 }; New-Item -ItemType Directory -Path \"${workspaceFolder}\\.vscode\" -Force | Out-Null; $process = Start-Process -FilePath pnpm -ArgumentList @('--dir', '${workspaceFolder}', 'dev') -WorkingDirectory '${workspaceFolder}' -NoNewWindow -PassThru; Set-Content -Path \"${workspaceFolder}\\.vscode\\.ui-dev.lock\" -Value $process.Id; Wait-Process -Id $process.Id"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "-lc",
          "lsof -nP -iTCP:3000 -sTCP:LISTEN -t >/dev/null 2>&1 && exit 0; mkdir -p \"${workspaceFolder}/.vscode\"; printf '%s\\n' \"$$\" > \"${workspaceFolder}/.vscode/.ui-dev.lock\"; exec pnpm --dir \"${workspaceFolder}\" dev"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "-lc",
          "lsof -nP -iTCP:3000 -sTCP:LISTEN -t >/dev/null 2>&1 && exit 0; mkdir -p \"${workspaceFolder}/.vscode\"; printf '%s\\n' \"$$\" > \"${workspaceFolder}/.vscode/.ui-dev.lock\"; exec pnpm --dir \"${workspaceFolder}\" dev"
        ]
      },
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|ready started server on)"
        }
      }
    },
    {
      "label": "ui:build",
      "type": "shell",
      "command": "pnpm",
      "args": ["build"]
    },
    {
      "label": "ui:stop",
      "type": "shell",
      "command": "",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "if (Test-Path \"${workspaceFolder}\\.vscode\\.ui-dev.lock\") { $owningProcessId = (Get-Content \"${workspaceFolder}\\.vscode\\.ui-dev.lock\" -Raw).Trim(); $process = Get-CimInstance Win32_Process -Filter \"ProcessId = $owningProcessId\" -ErrorAction SilentlyContinue; if ($process -and $process.CommandLine -like '*pnpm*' -and $process.CommandLine -like '*--dir*' -and $process.CommandLine -like '*dev*' -and $process.CommandLine.Contains('${workspaceFolder}')) { Stop-Process -Id $owningProcessId -Force }; Remove-Item -Force \"${workspaceFolder}\\.vscode\\.ui-dev.lock\" }"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "-lc",
          "lock=\"${workspaceFolder}/.vscode/.ui-dev.lock\"; if [ -f \"$lock\" ]; then process_id=$(cat \"$lock\"); command=$(ps -p \"$process_id\" -o args= 2>/dev/null || true); case \"$command\" in *\"pnpm --dir ${workspaceFolder} dev\"*) kill \"$process_id\" 2>/dev/null || true ;; esac; rm -f \"$lock\"; fi"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "-lc",
          "lock=\"${workspaceFolder}/.vscode/.ui-dev.lock\"; if [ -f \"$lock\" ]; then process_id=$(cat \"$lock\"); command=$(ps -p \"$process_id\" -o command= 2>/dev/null || true); case \"$command\" in *\"pnpm --dir ${workspaceFolder} dev\"*) kill \"$process_id\" 2>/dev/null || true ;; esac; rm -f \"$lock\"; fi"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      }
    }
  ]
}
